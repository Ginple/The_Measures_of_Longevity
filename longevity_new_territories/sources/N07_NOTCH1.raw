    <meta name="journal_id" content="41588"/>
    <meta name="dc.title" content="Notch1 mutations drive clonal expansion in normal esophageal epithelium but impair tumor growth"/>
    <meta name="dc.source" content="Nature Genetics 2023 55:2"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="Nature Publishing Group"/>
    <meta name="dc.date" content="2023-01-19"/>
